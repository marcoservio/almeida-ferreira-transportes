# Ver https://help.github.com/articles/ignoring-files/
#
# IMPORTANTE — o que NÃO pode entrar aqui, senão o deploy na Vercel quebra:
#   • package.json e package-lock.json (a Vercel instala as dependências com eles)
#   • a pasta public/ e as imagens (logo, foto do caminhão, ícone, opengraph)
#   • qualquer arquivo .ts/.tsx do app
# A Vercel faz o build no servidor a partir do que está commitado.

# ── Dependências ──────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build do Next.js ──────────────────────────────────────────────────────────
/.next/
/out/
/build
/dist
.turbo/
.swc/

# ── Variáveis de ambiente (NUNCA subir chaves) ────────────────────────────────
# .env.example continua versionado, serve de modelo para a equipe.
.env
.env.local
.env*.local
.env.development
.env.production

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel

# ── Supabase (CLI local) ──────────────────────────────────────────────────────
/supabase/.temp
/supabase/.branches
/supabase/logs

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Caches e logs ─────────────────────────────────────────────────────────────
.eslintcache
.cache/
.parcel-cache/
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Testes ────────────────────────────────────────────────────────────────────
/coverage
/playwright-report
/test-results

# ── Editores e IDEs ───────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# ── Sistema operacional ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Chaves e certificados ─────────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx

# ── Documentos internos da empresa ────────────────────────────────────────────
# Coloque aqui CRLVs, acertos de motorista, planilhas e qualquer documento com
# dado pessoal. Não pode ir para o repositório — se ele for público, vaza.
/private/
/documentos/
*.local.*

# ── Ferramentas locais ────────────────────────────────────────────────────────
.claude/settings.local.json
